{
  "nodeModulesDir": "none",
  "imports": {
    "@clearpath/contracts": "./packages/contracts/mod.ts",
    "@clearpath/checks": "./packages/checks/mod.ts",
    "@clearpath/models": "./packages/models/mod.ts",
    "fastify": "npm:fastify@5.12.8",
    "@fastify/cookie": "npm:@fastify/cookie@11.0.2",
    "@fastify/cors": "npm:@fastify/cors@11.2.0",
    "zod": "npm:zod@4.6.7",
    "postgres": "npm:postgres@3.4.7",
    "@electric-sql/pglite": "npm:@electric-sql/pglite@0.5.15"
  },
  "tasks": {
    "dev:api": "deno run --env-file=.env --allow-net --allow-env --allow-read --allow-write=.data --allow-sys --watch apps/api/src/main.ts",
    "start:api": "deno run --allow-net --allow-env --allow-read --allow-sys apps/api/src/main.ts",
    "test": "deno test --allow-env --allow-read --allow-write=.data --allow-net --allow-sys packages apps/api/test scripts/dashboard_test.ts scripts/review_map_test.ts scripts/reference_pages_test.ts scripts/submission_journey_test.ts",
    "check": "deno check apps/api/src/main.ts packages/checks/mod.ts",
    "migrate": "deno run --env-file=.env --allow-net --allow-env --allow-read --allow-write=.data --allow-sys packages/models/migrate.ts"
  },
  "compilerOptions": { "strict": true, "lib": ["deno.ns", "dom", "esnext"] },
  "fmt": { "lineWidth": 100, "singleQuote": false },
  "exclude": ["apps/web", "node_modules", ".data", ".codegraph"],
  "deploy": {
    "org": "samctensen",
    "app": "clearpath-api"
  }
}
