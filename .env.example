# API production: Neon pooled connection string. Never commit real credentials.
DATABASE_URL=
# Omit DATABASE_URL locally to use embedded Postgres in .data/.
API_PORT=8000
# Set a random secret of at least 32 characters in production.
COOKIE_SECRET=
# Comma-separated browser origins allowed to mutate the API.
WEB_ORIGIN=http://localhost:3000
# Set only for production deployments.
NODE_ENV=development
# Optional server-side AI reviews; omit the key to keep AI generation unavailable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
# Global attempts per UTC day; each workspace also has a limit of 10.
AI_REVIEW_DAILY_LIMIT=50
